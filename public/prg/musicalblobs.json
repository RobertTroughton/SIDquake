{
  "name": "Musical Blobs",
  "version": "1.3",
  "maxCallsPerFrame": 1,
  "needsSaveRestore": true,
  "fontType": "1x1",
  "layouts": {
    "bank4000": {
      "size": "0x4000",
      "baseAddress": "0x4000",
      "dataAddress": "0x4000",
      "sysAddress": "0x4100",
      "binaryDataStart": "0x4000",
      "binaryDataEnd": "0x7FFF",
      "borderColor": "0x400D",
      "backgroundColor": "0x400E",
      "charsetAddress": "0x6500",
      "charsetSize": "0x300",
      "graphicsBase": "0x5500",
      "relocSplit": "0x5500",
      "saveRestoreLocation": "before",
      "saveRestoreEndAddress": "0x4000",
      "saveRestoreMaxSize": "0x3800",
      "charsetAltAddress": "0x5500",
      "bakedLoopMinAddress": "0x405B",
      "bakedLoopSecAddress": "0x405C",
      "bakedLenMinAddress": "0x405D",
      "bakedLenSecAddress": "0x405E",
      "bakedHasLengthAddress": "0x405F",
      "bakedLoopEndMinAddress": "0x404C",
      "bakedLoopEndSecAddress": "0x404D",
      "graphicsSegments": [
        { "name": "Graphics: screen RAM + sprite pointers", "off": "0x0300", "len": "0x0400" },
        { "name": "Graphics: colour table → $D800", "off": "0x0700", "len": "0x0200" },
        { "name": "Graphics: charset", "off": "0x0B00", "len": "0x0500" },
        { "name": "Graphics: song-name font", "off": "0x1000", "len": "0x0300" },
        { "name": "Graphics: sprites (curtain)", "off": "0x1900", "len": "0x0040" },
        { "name": "Graphics: spectrum bitmap (blobs)", "off": "0x1A00", "len": "0x1100" }
      ]
    }
  },
  "inputs": [
    {
      "id": "logo-input",
      "label": "Logo",
      "type": "file",
      "accept": ".png",
      "required": false,
      "default": "PNG/Logos/scrap-leaf-charset.png",
      "description": "320x200 or 384x272 PNG; only the top 11 char rows (88px) are shown. Charset-friendly images export as a charset; anything else becomes part of the spectrum bitmap.",
      "convertType": "logo",
      "charsetModes": [
        "mixed",
        "bitmap"
      ],
      "charsetRows": 11,
      "charsetMaxChars": 159,
      "memory": {
        "bank4000": [
          {
            "name": "gfx",
            "sourceOffset": "0x0002",
            "targetAddress": "0x6000",
            "size": "0x0DC0"
          },
          {
            "name": "screen",
            "sourceOffset": "0x1F42",
            "targetAddress": "0x5800",
            "size": "0x01B8"
          },
          {
            "name": "color",
            "sourceOffset": "0x232A",
            "targetAddress": "0x5C00",
            "size": "0x01B8"
          },
          {
            "name": "d021",
            "sourceOffset": "0x2712",
            "targetAddress": "0x400E",
            "size": "0x0001"
          },
          {
            "name": "d022",
            "sourceOffset": "0x2714",
            "targetAddress": "0x4071",
            "size": "0x0001"
          },
          {
            "name": "d023",
            "sourceOffset": "0x2715",
            "targetAddress": "0x4072",
            "size": "0x0001"
          },
          {
            "name": "logoMode",
            "sourceOffset": "0x2713",
            "targetAddress": "0x4070",
            "size": "0x0001"
          }
        ]
      },
      "galleryFiles": [
        "prg/galleries/logos.json"
      ]
    }
  ],
  "options": [
    {
      "id": "font",
      "label": "Song Name Font",
      "type": "fontSelector",
      "default": 1,
      "excludeROM": true
    },
    {
      "id": "borderColor",
      "label": "Border Colour",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 15,
      "dataField": "borderColor"
    }
  ],
  "relocatable": true,
  "gfxManifest": "prg/musicalblobs.gfx.json",
  "relocBaseLayout": "bank4000",
  "relocCodeBase": "prg/MusicalBlobs-code.bin",
  "relocCodeTable": "prg/musicalblobs.codereloc.json"
}
