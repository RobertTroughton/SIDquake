{
  "name": "Simple Bitmap",
  "maxCallsPerFrame": 8,
  "version": "1.0",
  "needsSaveRestore": false,
  "fontType": "1x1",
  "layouts": {
    "bank4000": {
      "binary": "prg/SimpleBitmapWithScroller-4000.bin",
      "baseAddress": "0x4000",
      "size": "0x4000",
      "dataAddress": "0x5000",
      "sysAddress": "0x5100",
      "binaryDataStart": "0x2800",
      "binaryDataEnd": "0x7FFF",
      "binaryCoreEnd": "0x5FFF",
      "borderColor": "0x500D",
      "backgroundColor": "0x500E",
      "scrollTextAddr": "0x2800",
      "scrollColor": "0x5080",
      "charsetAddress": "0x4400",
      "charsetSize": "0x300",
      "fontModeAddress": "0x5074",
      "scrollSpeed": "0x5075"
    },
    "bank8000": {
      "binary": "prg/SimpleBitmapWithScroller-8000.bin",
      "baseAddress": "0x8000",
      "size": "0x4000",
      "dataAddress": "0x9000",
      "sysAddress": "0x9100",
      "binaryDataStart": "0x6800",
      "binaryDataEnd": "0xBFFF",
      "binaryCoreEnd": "0x9FFF",
      "borderColor": "0x900D",
      "backgroundColor": "0x900E",
      "scrollTextAddr": "0x6800",
      "scrollColor": "0x9080",
      "charsetAddress": "0x8400",
      "charsetSize": "0x300",
      "fontModeAddress": "0x9074",
      "scrollSpeed": "0x9075"
    }
  },
  "inputs": [
    {
      "id": "bitmap-input",
      "label": "Picture",
      "type": "file",
      "accept": ".png",
      "required": false,
      "default": "PNG/Bitmaps/0-default.png",
      "description": "320x200 or 384x272 PNG. PETSCII, hires, mixed/multicolour and ECM images export as character graphics; other images fall back to hires or multicolour bitmap.",
      "convertType": "image",
      "charsetModes": [
        "petscii",
        "hires",
        "mixed",
        "ecm",
        "bitmap"
      ],
      "charsetMaxChars": 256,
      "inferredOptions": {
        "borderColor": "border"
      },
      "galleryFiles": [
        "prg/galleries/bitmaps.json"
      ],
      "gallery": [
        {
          "name": "Zebra (by redcrab)",
          "file": "PNG/Bitmaps/redcrab-Zebra.png"
        }
      ],
      "memory": {
        "bank4000": [
          {
            "name": "gfx",
            "sourceOffset": "0x0002",
            "targetAddress": "0x6000",
            "size": "0x1F40",
            "imageRegion": "gfx",
            "mapLabel": "Graphics: picture data"
          },
          {
            "name": "screen",
            "sourceOffset": "0x1F42",
            "targetAddress": "0x4800",
            "size": "0x03E8",
            "mapLabel": "Graphics: picture screen"
          },
          {
            "name": "color",
            "sourceOffset": "0x232A",
            "targetAddress": "0x4C00",
            "size": "0x03E8",
            "mapLabel": "Graphics: picture colour"
          },
          {
            "name": "background",
            "sourceOffset": "0x2712",
            "targetAddress": "0x500E",
            "size": "0x0001"
          },
          {
            "name": "border",
            "sourceOffset": "0x2719",
            "targetAddress": "0x500D",
            "size": "0x0001"
          },
          {
            "name": "bitmapMode",
            "sourceOffset": "0x2713",
            "targetAddress": "0x5070",
            "size": "0x0001"
          },
          {
            "name": "d022",
            "sourceOffset": "0x2714",
            "targetAddress": "0x5071",
            "size": "0x0001"
          },
          {
            "name": "d023",
            "sourceOffset": "0x2715",
            "targetAddress": "0x5072",
            "size": "0x0001"
          },
          {
            "name": "d024",
            "sourceOffset": "0x2716",
            "targetAddress": "0x5073",
            "size": "0x0001"
          }
        ],
        "bank8000": [
          {
            "name": "gfx",
            "sourceOffset": "0x0002",
            "targetAddress": "0xA000",
            "size": "0x1F40",
            "imageRegion": "gfx",
            "mapLabel": "Graphics: picture data"
          },
          {
            "name": "screen",
            "sourceOffset": "0x1F42",
            "targetAddress": "0x8800",
            "size": "0x03E8",
            "mapLabel": "Graphics: picture screen"
          },
          {
            "name": "color",
            "sourceOffset": "0x232A",
            "targetAddress": "0x8C00",
            "size": "0x03E8",
            "mapLabel": "Graphics: picture colour"
          },
          {
            "name": "background",
            "sourceOffset": "0x2712",
            "targetAddress": "0x900E",
            "size": "0x0001"
          },
          {
            "name": "border",
            "sourceOffset": "0x2719",
            "targetAddress": "0x900D",
            "size": "0x0001"
          },
          {
            "name": "bitmapMode",
            "sourceOffset": "0x2713",
            "targetAddress": "0x9070",
            "size": "0x0001"
          },
          {
            "name": "d022",
            "sourceOffset": "0x2714",
            "targetAddress": "0x9071",
            "size": "0x0001"
          },
          {
            "name": "d023",
            "sourceOffset": "0x2715",
            "targetAddress": "0x9072",
            "size": "0x0001"
          },
          {
            "name": "d024",
            "sourceOffset": "0x2716",
            "targetAddress": "0x9073",
            "size": "0x0001"
          }
        ]
      }
    }
  ],
  "options": [
    {
      "id": "borderColor",
      "label": "Border Color",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 15,
      "dataField": "borderColor"
    },
    {
      "id": "scrollText",
      "label": "Scroll Text",
      "type": "textarea",
      "default": "",
      "maxLength": 6144,
      "dataField": "scrollTextAddr",
      "mapLabel": "Scroll text",
      "prependSpaces": 8,
      "description": "Optional. If set, it scrolls across the bottom of the picture. Leave blank for just the picture.",
      "loadSave": true
    },
    {
      "id": "scrollColor",
      "label": "Scroll Color",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 15,
      "dataField": "scrollColor",
      "showWhen": {
        "scrollText": "nonempty"
      }
    },
    {
      "id": "scrollSpeed",
      "label": "Scroll Speed",
      "type": "select",
      "default": 2,
      "values": [
        {
          "value": 2,
          "label": "2 pixels/frame (default)"
        },
        {
          "value": 1,
          "label": "1 pixel/frame (slower)"
        }
      ],
      "dataField": "scrollSpeed",
      "showWhen": {
        "scrollText": "nonempty"
      }
    },
    {
      "id": "font",
      "label": "Font",
      "type": "fontSelector",
      "default": 1,
      "excludeROM": true,
      "showWhen": {
        "scrollText": "nonempty"
      }
    }
  ]
}
