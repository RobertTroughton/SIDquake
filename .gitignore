# Extracted HVSC mirror. The raw ~61k .sid files are NOT committed; instead the
# HVSC archive under hvsc-data/ is committed and extracted here at build time
# (npm run extract-hvsc). Keep this folder locally for offline dev + index builds.
/public/HVSC/

# Per-composer SEO pages + sitemap: generated from hvsc-index.json at build
# (npm run build-seo-pages). Derived output, not committed.
/public/music/
/public/sitemap.xml

# Per-tune share metadata shards for the tune-og edge function: generated
# from hvsc-index.json at build time (npm run build-share-meta).
/public/share-meta/
# Derived from the committed hvsc-index.json at build time
# (scripts/build-index-split.js).
/public/hvsc-index-lite.json
/public/hvsc-stil.json
/CSDbMusicFetch/xml

# Song length scanner journal + generated reports (see tools/songlengths/README.md)
tools/songlengths/out/
